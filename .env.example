# Application
AGENT_PROVIDER=lmstudio
AGENT_WORKSPACE=./agent_workspace
AGENT_DATA_DIR=./.agent_data
AGENT_CONTEXT_ROOT=./agent_workspace
AGENT_CONTEXT_TOP_K=8
# Legacy alias is also accepted: AGENT_RETRIEVAL_LIMIT
AGENT_AUTO_CONTEXT_MAX_CHARS=12000
AGENT_AUTO_CONTEXT_QUERY_MAX_CHARS=2000
AGENT_CONTEXT_MAX_FILE_MB=2048
AGENT_MODEL_TEMPERATURE=0.1
AGENT_REQUEST_TIMEOUT=120
AGENT_MODEL_CALL_RETRIES=3
AGENT_MODEL_RETRY_INITIAL_DELAY=1
AGENT_MODEL_RETRY_MAX_DELAY=15
AGENT_WEB_RETRY_ATTEMPTS=3
# Version 0.3.0 forces one tool call per model step; no toggle is required.

# LM Studio (the loaded model must support tool calling)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1

# Yandex AI Studio / YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alibaba Model Studio / Qwen
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
