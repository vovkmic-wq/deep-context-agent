# Application
# Production default: GLM-5.3 first, GPT-5.6 Sol second.
# Set AGENT_PROVIDER to select exactly one provider, or replace this ordered chain.
AGENT_PROVIDER=
AGENT_PROVIDER_PRIORITY=glm,openai
AGENT_WORKSPACE=./agent_workspace
AGENT_DATA_DIR=./.agent_data
AGENT_CONTEXT_ROOT=./agent_workspace
AGENT_CONTEXT_TOP_K=8
# Legacy alias is also accepted: AGENT_RETRIEVAL_LIMIT
AGENT_AUTO_CONTEXT_MAX_CHARS=12000
AGENT_AUTO_CONTEXT_QUERY_MAX_CHARS=2000
AGENT_CONTEXT_MAX_FILE_MB=2048
AGENT_MODEL_TEMPERATURE=0.1
AGENT_REQUEST_TIMEOUT=120
AGENT_MODEL_CALL_RETRIES=3
AGENT_MODEL_RETRY_INITIAL_DELAY=1
AGENT_MODEL_RETRY_MAX_DELAY=15
AGENT_WEB_RETRY_ATTEMPTS=3
AGENT_RECURSION_LIMIT=100
AGENT_AUDIT_BATCH_SIZE=8
AGENT_AUDIT_MAX_BATCHES_PER_REQUEST=4
AGENT_AUDIT_MAX_READS_PER_FILE=4
# Optional comma/newline-separated audit globs. Built-in generated/dependency
# exclusions always remain active.
AGENT_AUDIT_INCLUDE=
AGENT_AUDIT_EXCLUDE=
AGENT_PROJECT_CHECK_TIMEOUT_SECONDS=300
AGENT_PROJECT_CHECK_OUTPUT_MAX_CHARS=20000
# Local Web UI. Keep delete disabled unless an operator explicitly needs it.
AGENT_WEB_AUTH_TOKEN=
AGENT_WEB_TRUSTED_HTTPS_PROXY=0
AGENT_WEB_ALLOW_DELETE=0
# One tool call per model step is mandatory; no toggle is required.

# LM Studio (the loaded model must support tool calling)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Chat Completions function tools require none for GPT-5.6 Sol.
OPENAI_REASONING_EFFORT=none
OPENAI_BASE_URL=https://api.openai.com/v1

# Yandex AI Studio / YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alibaba Model Studio / Qwen
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Zhipu AI / GLM (provider: zhipu; alias: glm)
ZAI_API_KEY=
ZAI_MODEL=glm-5.3
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# A GLM Coding Plan key requires:
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
