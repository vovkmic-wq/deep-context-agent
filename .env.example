# Application
# Production default: GLM-5.3 first, GPT-5.6 Sol second.
# Set AGENT_PROVIDER to select exactly one provider, or replace this ordered chain.
AGENT_PROVIDER=
AGENT_PROVIDER_PRIORITY=glm,openai
AGENT_WORKSPACE=./agent_workspace
AGENT_DATA_DIR=./.agent_data
AGENT_CONTEXT_ROOT=./agent_workspace
AGENT_CONTEXT_TOP_K=8
# Legacy alias is also accepted: AGENT_RETRIEVAL_LIMIT
AGENT_AUTO_CONTEXT_MAX_CHARS=12000
AGENT_AUTO_CONTEXT_QUERY_MAX_CHARS=2000
# Approximate model-input threshold; old tool bodies are compacted transiently.
AGENT_ACTIVE_CONTEXT_MAX_TOKENS=80000
# Per-run safety budgets; model retries do not replay completed file operations.
AGENT_MODEL_OUTPUT_TOKENS=8192
AGENT_TASK_MODEL_ATTEMPTS=80
AGENT_TASK_TIMEOUT_SECONDS=900
AGENT_MODEL_TURN_TIMEOUT_SECONDS=180
AGENT_NO_PROGRESS_LIMIT=8
# off / observe / enforce; repetition detection is conservative and non-streaming.
AGENT_REPETITION_MODE=observe
# Semantic classifier only for ambiguous references; exact resume is local.
AGENT_SEMANTIC_ROUTING=true
AGENT_SEMANTIC_ROUTING_TIMEOUT=10
# JSON array of explicitly configured model profiles; empty preserves current chain.
# Each profile: provider, model, tier=fast|standard|reasoning, context_tokens, tools.
# Optional: input_usd_per_million, output_usd_per_million, latency_ms, quality, enabled.
# Unknown prices/latency are NOT zero. Use real operator-verified metadata.
AGENT_MODEL_PROFILES=
# Per-call estimated cost and expected latency ceilings (0 disables the ceiling).
AGENT_MODEL_COST_LIMIT_USD=0
AGENT_MODEL_LATENCY_BUDGET_MS=0
# Only loopback LM Studio is eligible when true; remote fallback is prohibited.
AGENT_MODEL_LOCAL_ONLY=false
# Optional tokenizer mode: conservative (offline default) or tiktoken. Any
# tokenizer failure falls back locally and never triggers a model download.
AGENT_TOKEN_ESTIMATOR=conservative
AGENT_CONTEXT_MAX_FILE_MB=2048
# Local hybrid memory. Embeddings are computed inside this Python process on
# CPU; indexed documents are never sent to an external embedding API.
AGENT_RETRIEVAL_MODE=hybrid
AGENT_EMBEDDING_ENABLED=true
AGENT_EMBEDDING_PROVIDER=fastembed
AGENT_EMBEDDING_DEVICE=cpu
AGENT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 0 selects an automatically bounded batch size based on available RAM.
AGENT_EMBEDDING_BATCH_SIZE=0
AGENT_VECTOR_STORE=qdrant
AGENT_EXTERNAL_EMBEDDING_FALLBACK=false
AGENT_MODEL_TEMPERATURE=0.1
AGENT_REQUEST_TIMEOUT=120
AGENT_MODEL_CALL_RETRIES=3
AGENT_MODEL_RETRY_INITIAL_DELAY=1
AGENT_MODEL_RETRY_MAX_DELAY=15
AGENT_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=1
AGENT_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=300
AGENT_WEB_RETRY_ATTEMPTS=3
AGENT_RECURSION_LIMIT=100
AGENT_AUDIT_BATCH_SIZE=8
AGENT_AUDIT_MAX_BATCHES_PER_REQUEST=4
AGENT_AUDIT_MAX_READS_PER_FILE=4
# Optional comma/newline-separated audit globs. Built-in generated/dependency
# exclusions always remain active.
AGENT_AUDIT_INCLUDE=
AGENT_AUDIT_EXCLUDE=
# Persistent autopilot controller. These are operator safety ceilings, not
# fields the end user must calculate for each task.
AGENT_AUTOPILOT_MAX_WORK_UNITS=200
AGENT_AUTOPILOT_MAX_REPLANS=12
AGENT_AUTOPILOT_RETRY_ATTEMPTS=3
AGENT_AUTOPILOT_REPAIR_CYCLES=3
AGENT_AUTOPILOT_LEASE_SECONDS=900
AGENT_AUTOPILOT_HEARTBEAT_SECONDS=30
AGENT_AUTOPILOT_UNIT_TIMEOUT_SECONDS=900
AGENT_AUTOPILOT_TASK_ACTIVE_TIME_SECONDS=14400
AGENT_AUTOPILOT_MAX_WALL_TIME_SECONDS=86400
AGENT_DISCOVERY_MAX_UNITS=2
AGENT_DISCOVERY_MAX_READS=20
AGENT_DISCOVERY_MAX_UNIQUE_LINES=2000
AGENT_DISCOVERY_MAX_SEARCHES=8
AGENT_TARGETED_DISCOVERY_MAX_UNITS=1
AGENT_AUTOPILOT_UNIT_BATCH_SIZE=2
AGENT_AUTOPILOT_RECURSION_LIMIT=40
AGENT_AUTOPILOT_SOFT_MODEL_CALLS_PER_UNIT=8
AGENT_AUTOPILOT_MAX_READ_PAGES_PER_FILE=512
AGENT_AUTOPILOT_MAX_READ_BYTES_PER_FILE=67108864
AGENT_EXECUTION_ESCALATION_ENABLED=true
AGENT_MANUAL_EXECUTION_ESCALATION=false
AGENT_EXECUTION_ESCALATION_FAILURE_THRESHOLD=2
AGENT_EXECUTION_ESCALATION_MAX_EVENTS=2
AGENT_PROJECT_CHECK_TIMEOUT_SECONDS=300
AGENT_PROJECT_CHECK_OUTPUT_MAX_CHARS=20000
# Durable request diagnostics outside checkpoint rollback.
# redacted is the safe production default; full is an explicit privacy opt-in.
AGENT_FAILURE_LOG_MODE=redacted
AGENT_FAILURE_LOG_RETENTION_DAYS=30
AGENT_FAILURE_LOG_MAX_ROWS=10000
AGENT_FAILURE_LOG_QUERY_MAX_BYTES=65536
# Local Web UI. Keep delete disabled unless an operator explicitly needs it.
# Live provider order changes in Web are process-local; edit
# AGENT_PROVIDER_PRIORITY here for the next process start.
AGENT_WEB_AUTH_TOKEN=
AGENT_WEB_TRUSTED_HTTPS_PROXY=0
AGENT_WEB_ALLOW_DELETE=0
# One tool call per model step is mandatory; no toggle is required.

# LM Studio (local API calls have no provider fee; model must support tool calling)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# In Web UI, the placeholder local-model is resolved to a loaded chat model.
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=

# Web-only custom OpenAI-compatible providers use IDs like custom-company.
# Remote credentials stay server-side in CUSTOM_<ID>_API_KEY variables.
# Example: custom-company -> CUSTOM_COMPANY_API_KEY

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Chat Completions function tools require none for GPT-5.6 Sol.
OPENAI_REASONING_EFFORT=none
OPENAI_BASE_URL=https://api.openai.com/v1

# Yandex AI Studio / YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alibaba Model Studio / Qwen
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Zhipu AI / GLM (provider: zhipu; alias: glm)
ZAI_API_KEY=
ZAI_MODEL=glm-5.3
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# A GLM Coding Plan key requires:
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
